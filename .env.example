# Railway PostgreSQL. Leave empty for temporary in-memory demo mode.
DATABASE_URL="postgresql://postgres:password@host:5432/railway"

# First admin account. Change these in Railway Variables.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-this-password"

# Used to sign the admin session cookie.
AUTH_SECRET="replace-with-a-long-random-secret"

# Public base URL, e.g. https://dark-production.up.railway.app
NEXT_PUBLIC_APP_URL="https://your-app.up.railway.app"
